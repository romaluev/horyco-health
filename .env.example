# Telegram bot token from @BotFather
BOT_TOKEN=

# PostgreSQL connection string
# Local: postgresql://postgres:postgres@localhost:5432/eatfit
# Coolify (internal): postgresql://user:pass@horyco-health-postgres-dev:5432/horyco_health
DATABASE_URL=postgresql://user:password@localhost:5432/eatfit

# Coolify internal Postgres does not use SSL. Set explicitly if auto-detection fails.
DATABASE_SSL=false

# Admin telegram ids (comma separated). These users get the admin role automatically.
ADMIN_TELEGRAM_IDS=123456789,987654321

# Group chat id where new orders are sent for cooks
COOK_GROUP_ID=-100xxxxxxxxx

# Group chat id where ready orders are sent for couriers
COURIER_GROUP_ID=-100xxxxxxxxx

# Group chat id for admins: live order cards, balance alerts, daily summary
ADMIN_GROUP_ID=-100xxxxxxxxx

# Daily summary settings (sent to ADMIN_GROUP_ID)
TZ_OFFSET_HOURS=5        # timezone offset from UTC (Uzbekistan = 5)
DAILY_REPORT_HOUR=19     # local hour to send the daily summary (0-23)

# Bot username WITHOUT @ — used to build deep links
BOT_USERNAME=eatfit_bot

# Channel for publishing posts directly (no "forwarded from").
# Bot must be an admin of this channel. Use @channelusername or -100xxxxxxxxx
CHANNEL_ID=@eatfit_channel

# ---- Mini App / website (optional) ----
# Public HTTPS url of the Mini App. When set, the bot shows a menu button
# and an "Open app" button.
# Dev:  https://dev-health.horyco.com
# Prod: https://health.horyco.com
WEB_APP_URL=https://dev-health.horyco.com

# Comma-separated CORS origins (optional; same-origin SPA usually needs none in prod)
CORS_ORIGINS=https://dev-health.horyco.com

# Web server port (Coolify sets PORT automatically; locally defaults to 3000)
PORT=3000

# ---- NestJS API ----
# JWT signing secret (minimum 32 characters)
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=7d

# Schema is managed by migrations (see DEPLOYMENT.md → "Migrations").
# TYPEORM_SYNC must stay false; it exists only as an explicit local-dev escape hatch.
TYPEORM_SYNC=false
# Run pending migrations on boot (safe with a single replica).
# On a LIVE database created by the old synchronize mode: set false, register the
# baseline once with `migration:run --fake` (DEPLOYMENT.md), then set true.
TYPEORM_MIGRATIONS_RUN=true

# Only one replica should poll Telegram (409 if multiple). Set false on extra replicas.
# Outbound notifications (groups, client DMs) still work when false; only polling and
# bot commands are disabled. Daily report cron runs on all replicas — use one replica
# in production or accept duplicate reports when scaling without per-replica env.
BOT_ENABLED=true
