# Optional fallback bot token (per-business tokens preferred via back office)
BOT_TOKEN=

# PostgreSQL connection string
# Local: postgresql://postgres:postgres@localhost:5432/eatfit
# Coolify (internal): postgresql://user:pass@horyco-health-postgres-dev:5432/horyco_health
DATABASE_URL=postgresql://user:password@localhost:5432/eatfit

# Coolify internal Postgres does not use SSL. Set explicitly if auto-detection fails.
DATABASE_SSL=false

# Platform admin bootstrap (optional)
# Synced on every API boot: creates or updates platform admin password for this phone.
# Changing password here + redeploy resets browser login at /platform and /b.
PLATFORM_ADMIN_PHONE=
PLATFORM_ADMIN_PASSWORD=
PLATFORM_ADMIN_NAME=Platform Admin

# Platform admin seed (comma separated). Sets is_platform_admin on first /start.
ADMIN_TELEGRAM_IDS=123456789,987654321

# Default TZ / report hour (per-business overrides in back office settings)
TZ_OFFSET_HOURS=5
DAILY_REPORT_HOUR=19

# Bot username WITHOUT @ — legacy deep-link fallback
BOT_USERNAME=eatfit_bot

# ---- Mini App / website ----
WEB_APP_URL=https://dev-health.horyco.com
PUBLIC_URL=https://dev-health.horyco.com

CORS_ORIGINS=https://dev-health.horyco.com

PORT=3000

# ---- NestJS API ----
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=7d

# Bot-token encryption key (AES-256-GCM), exactly 64 hex chars. REQUIRED.
# Generate: openssl rand -hex 32
TOKEN_ENC_KEY=

TYPEORM_SYNC=false
TYPEORM_MIGRATIONS_RUN=true

BOT_ENABLED=true
BOT_MODE=webhook

# CSP: true = Report-Only (default); false = enforce
CSP_REPORT_ONLY=true

# Telegram groups/channels: bind per business via /bind in bot (no env vars)
